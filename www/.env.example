MORI_LLM_PROVIDER=deepseek

# Provider keys stay server-side. DeepSeek is the current Pulse writer.
# OpenAI is used as the live Clarity Pulse search source when configured.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

MORI_OPENAI_MODEL=gpt-4o-mini
MORI_OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview
MORI_GEMINI_MODEL=gemini-2.5-flash
MORI_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional overrides.
MORI_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
MORI_OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
MORI_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
