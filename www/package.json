{
  "name": "mori-ui",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Mori UI System - React Component Library",
  "main": "dist/mori-ui.umd.cjs",
  "module": "dist/mori-ui.es.js",
  "types": "dist/index.d.ts",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mori-ui.es.js",
      "require": "./dist/mori-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "sync:assets": "../scripts/sync_web_bitmap_assets.sh",
    "check:assets": "../scripts/sync_web_bitmap_assets.sh --check",
    "build": "pnpm run build:library",
    "build:app": "pnpm check:assets && tsc && vite build",
    "build:library": "pnpm check:assets && tsc && vite build --mode library && tsc -p tsconfig.library.json",
    "prepack": "pnpm run build:library",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
